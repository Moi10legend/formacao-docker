Vagrant.configure("2") do |config|
  # Usaremos uma imagem do Ubuntu 22.04
  config.vm.box = "ubuntu/jammy64"

  # Script comum para instalar o Docker em todas as máquinas
  install_docker = <<-SHELL
    echo "Instalando o Docker..."
    curl -fsSL https://get.docker.com -o get-docker.sh
    sh get-docker.sh
    usermod -aG docker vagrant
  SHELL

  # ---------------------------------------------------------
  # 1. Configuração do Master (Manager do Swarm)
  # ---------------------------------------------------------
  config.vm.define "master" do |master|
    master.vm.hostname = "master"
    master.vm.network "private_network", ip: "192.168.50.10"
    
    # Instala o Docker
    master.vm.provision "shell", inline: install_docker
    
    # Inicializa o Swarm e salva o token na pasta compartilhada
    master.vm.provision "shell", inline: <<-SHELL
      echo "Inicializando o Docker Swarm..."
      docker swarm init --advertise-addr 192.168.50.10
      # Salva apenas o token de worker num arquivo para os nodes lerem
      docker swarm join-token -q worker > /vagrant/worker_token
    SHELL
  end

  # ---------------------------------------------------------
  # 2. Configuração dos Nodes (Workers do Swarm)
  # ---------------------------------------------------------
  # Usando um loop Ruby para criar node01, node02 e node03
  (1..3).each do |i|
    config.vm.define "node0#{i}" do |node|
      node.vm.hostname = "node0#{i}"
      node.vm.network "private_network", ip: "192.168.50.1#{i}" # IPs: 11, 12, 13
      
      # Instala o Docker
      node.vm.provision "shell", inline: install_docker
      
      # Entra no Swarm usando o token salvo pelo master
      node.vm.provision "shell", inline: <<-SHELL
        echo "Juntando-se ao cluster Swarm..."
        # Aguarda o arquivo do token ser criado (caso os nodes subam rápido demais)
        while [ ! -f /vagrant/worker_token ]; do sleep 2; done
        
        TOKEN=$(cat /vagrant/worker_token)
        docker swarm join --token $TOKEN 192.168.50.10:2377
      SHELL
    end
  end
end